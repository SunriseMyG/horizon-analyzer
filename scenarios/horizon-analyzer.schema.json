        "type": "string"
      },
      "title": "Ignore Console",
      "type": "array"
    },
    "fail_on_console": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Fail On Console",
      "type": "array"
    },
    "features": {
      "items": {
