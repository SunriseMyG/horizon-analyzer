  "additionalProperties": false,
  "description": "A scenario file. ``base_urls`` are reachable as ``${base.<name>}``, ``vars`` as ``${var.<name>}``.\n\n``locale`` (e.g. ``fr-FR``) fixes the browser language, so text selectors don't change with\nthe machine running the suite (the launcher and Stripe follow the browser's language).\n\n``ignore_console`` hides matching console errors from the report. ``fail_on_console`` fails\na feature whose steps all passed when one of its console errors matches, whenever it\nappeared during the feature (a wasm panic can land after the step that would have caught it).",
  "properties": {
    "suite": {
      "title": "Suite",
      "type": "string"
    },
    "description": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
