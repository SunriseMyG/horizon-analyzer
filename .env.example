# Copier en .env (ignoré par git) et remplir.
# Compte de test dédié : jamais de compte personnel ici.
HORIZON_EMAIL=
HORIZON_PASSWORD=

# Pour scenarios/atp.yaml (F1) : mot de passe du compte jetable que le test crée puis supprime
# à chaque run. 8 caractères minimum, avec une majuscule, une minuscule, un chiffre et un
# caractère spécial (règles du service d'authentification).
HORIZON_SIGNUP_PASSWORD=

# Optionnel : webhook Discord ou Slack prévenu quand une feature échoue.
HORIZON_WEBHOOK_URL=
